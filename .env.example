PORT=5001

# Firebase Admin SDK (server-side only — never bundled into client)
# Path to the service-account JSON (relative to project root)
GOOGLE_APPLICATION_CREDENTIALS=server/secrets/serviceAccountKey.json
FIREBASE_PROJECT_ID=olio-wallet
# Cloud Storage bucket the Admin SDK targets for signed-URL uploads
# (read by server/firebase.ts). Optional — defaults to
# olio-wallet.firebasestorage.app when unset.
FIREBASE_STORAGE_BUCKET=olio-wallet.firebasestorage.app

# OpenAI (server-side only). Local dev reads this from .env.
# Production reads from a Firebase Functions Secret of the same name — set with:
#   firebase functions:secrets:set OPENAI_API_KEY --project olio-wallet
OPENAI_API_KEY=

# Resend — powers /admin/email-marketing. Local dev reads these from .env;
# production from Firebase Functions Secrets.
#   firebase functions:secrets:set RESEND_API_KEY --project olio-wallet
#   firebase functions:secrets:set RESEND_FROM --project olio-wallet
#   firebase functions:secrets:set RESEND_WEBHOOK_SECRET --project olio-wallet
# RESEND_FROM is the verified sender, e.g. "Olio <noreply@oliowallet.com>"
# RESEND_WEBHOOK_SECRET is the whsec_... value from Resend dashboard.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# Random secret (32+ bytes) used to sign one-click unsubscribe tokens.
# Generate locally with: openssl rand -hex 32
#   firebase functions:secrets:set UNSUBSCRIBE_SECRET --project olio-wallet
UNSUBSCRIBE_SECRET=

# Optional override for the base URL embedded in unsubscribe links. Defaults
# to https://app.oliowallet.com when unset. Useful in local dev / staging.
PUBLIC_APP_URL=

# Stripe — used for owner subscriptions (Stripe Payments extension) and
# tenant rent payments routed to owners via Stripe Connect.
#   firebase functions:secrets:set STRIPE_SECRET_KEY --project olio-wallet
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET --project olio-wallet
#   firebase functions:secrets:set STRIPE_CONNECT_WEBHOOK_SECRET --project olio-wallet
# There are TWO webhook endpoints, each with its own whsec_ (Stripe Dashboard →
# Developers → Webhooks), and each must be set up in BOTH modes (test + live;
# production is live since 2026-06-24):
#   STRIPE_WEBHOOK_SECRET         — the "Your account" (platform) endpoint.
#                                   Events: account.updated,
#                                   customer.subscription.{created,updated,deleted},
#                                   invoice.payment_failed (owner-plan delinquency).
#   STRIPE_CONNECT_WEBHOOK_SECRET — the "Connected accounts" (connect:true)
#                                   endpoint carrying owners' direct-charge
#                                   events. Required for rent payments to record.
#                                   Events: checkout.session.completed,
#                                   payment_intent.succeeded, charge.refunded,
#                                   account.updated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Firebase Web SDK (bundled into client/app and client/platform)
# Public values — safe to commit. Get them from:
#   Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
# Use the Firebase-managed authDomain so the OAuth handler at /__/auth/**
# is served by Firebase itself. Custom domains break this because the
# Hosting "**" → /index.html rewrite intercepts the handler routes.
VITE_FIREBASE_AUTH_DOMAIN=olio-wallet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=olio-wallet
VITE_FIREBASE_STORAGE_BUCKET=olio-wallet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=616442647680
VITE_FIREBASE_APP_ID=
# NOTE: currently UNUSED by client code — no `getAnalytics`/`measurementId`
# reader exists. Kept only because the build/deploy workflow still passes it
# through. Safe to leave blank; remove once Analytics is confirmed not coming.
VITE_FIREBASE_MEASUREMENT_ID=

# OneSignal Web Push — drives push notifications on app.oliowallet.com.
# App ID is public (ships in the client bundle). REST API Key is secret;
# production reads it from a Firebase Functions Secret of the same name:
#   firebase functions:secrets:set ONESIGNAL_REST_API_KEY --project olio-wallet
# Local dev reads ONESIGNAL_REST_API_KEY from this .env.
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
